# MongoDB Atlas connection string.
# Get this from Atlas: Database > Connect > Drivers, then replace
# <username>, <password>, and the database name.
# Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campus-opportunity-finder?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/campus-opportunity-finder?retryWrites=true&w=majority

# Port the Express server listens on
PORT=5000

# Secret used to sign JWT tokens - use a long, random string in production
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# Environment
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS
CLIENT_URL=http://localhost:5173

# Default administrator account created by the seed script (npm run seed:admin)
ADMIN_NAME=Campus Admin
ADMIN_EMAIL=admin@campusopportunityfinder.com
ADMIN_PASSWORD=Admin@12345
